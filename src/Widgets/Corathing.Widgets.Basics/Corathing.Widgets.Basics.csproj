<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
	  <Nullable>enable</Nullable>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <UseWPF>true</UseWPF>
	  <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

	<ItemGroup>
		<Content Include="Assets\Monaco\**">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="DataSources\DotNetCodes\**" />
	  <Compile Remove="LogicNodes\**" />
	  <EmbeddedResource Remove="DataSources\DotNetCodes\**" />
	  <EmbeddedResource Remove="LogicNodes\**" />
	  <None Remove="DataSources\DotNetCodes\**" />
	  <None Remove="LogicNodes\**" />
	  <Page Remove="DataSources\DotNetCodes\**" />
	  <Page Remove="LogicNodes\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="widgets-entrypoint.json" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="widgets-entrypoint.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties /></VisualStudio></ProjectExtensions>

	<ItemGroup>
		<Folder Include="Assets\Monaco\" />
		<Folder Include="DataSources\DotNetEnvironments\CompilerPlatforms\" />
		<Folder Include="DataSources\PythonCodes\" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Shared\Corathing.Contracts\Corathing.Contracts.csproj" />
	  <ProjectReference Include="..\..\Shared\Corathing.UI.WPF\Corathing.UI.WPF.csproj" />
	</ItemGroup>

</Project>
